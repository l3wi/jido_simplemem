# Required
# SimpleMem parity mode is LLM-first. The default example below routes models
# through Vercel AI Gateway using an OpenAI-compatible base URL.
JIDO_SIMPLEMEM_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
JIDO_SIMPLEMEM_LLM_MODEL="alibaba/qwen3.5-plus"
JIDO_SIMPLEMEM_EMBEDDING_MODEL="alibaba/qwen3-embedding-4b"
AI_GATEWAY_API_KEY=""
JIDO_SIMPLEMEM_GATEWAY_RECEIVE_TIMEOUT_MS="300000"
JIDO_SIMPLEMEM_GATEWAY_POOL_TIMEOUT_MS="300000"
JIDO_SIMPLEMEM_GATEWAY_CONNECT_TIMEOUT_MS="60000"

# Optional
# Override individual LLM stages when needed.
JIDO_SIMPLEMEM_EXTRACTION_MODEL=""
JIDO_SIMPLEMEM_PLANNING_MODEL=""
JIDO_SIMPLEMEM_SYNTHESIS_MODEL=""
JIDO_SIMPLEMEM_ANSWER_MODEL=""

# Optional
# LanceDB is the only backend. If omitted, the default path is .jido/simplemem.lance.
JIDO_SIMPLEMEM_LANCE_PATH=""

# Optional worker overrides.
JIDO_SIMPLEMEM_PYTHON_EXECUTABLE=""
JIDO_SIMPLEMEM_UV_EXECUTABLE=""
JIDO_SIMPLEMEM_WORKER_START_TIMEOUT_MS=""

# Optional live integration test toggle.
JIDO_SIMPLEMEM_ENABLE_LIVE_LANCE_TESTS=""
