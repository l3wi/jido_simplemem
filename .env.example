# Required
JIDO_SIMPLEMEM_LLM_MODEL="openai:gpt-5-mini"
JIDO_SIMPLEMEM_EMBEDDING_MODEL="openai:text-embedding-3-small"
JIDO_SIMPLEMEM_EMBEDDING_DIMENSIONS="1536"
OPENAI_API_KEY=""

# Optional model overrides
JIDO_SIMPLEMEM_EXTRACTION_MODEL=""
JIDO_SIMPLEMEM_PLANNING_MODEL=""
JIDO_SIMPLEMEM_SYNTHESIS_MODEL=""
JIDO_SIMPLEMEM_ANSWER_MODEL=""

# Optional transport overrides for OpenAI-compatible endpoints.
# Leave these blank for direct provider access.
JIDO_SIMPLEMEM_BASE_URL=""
JIDO_SIMPLEMEM_API_KEY=""
JIDO_SIMPLEMEM_RECEIVE_TIMEOUT_MS="300000"
JIDO_SIMPLEMEM_POOL_TIMEOUT_MS="300000"

# Optional Lance worker configuration
JIDO_SIMPLEMEM_LANCE_PATH=""
JIDO_SIMPLEMEM_PYTHON_EXECUTABLE=""
JIDO_SIMPLEMEM_UV_EXECUTABLE=""
JIDO_SIMPLEMEM_WORKER_START_TIMEOUT_MS=""

# Optional live integration test toggle
JIDO_SIMPLEMEM_ENABLE_LIVE_LANCE_TESTS=""
