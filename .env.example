# Required
# Embeddings are mandatory. Set the model and the matching provider key.
JIDO_SIMPLEMEM_EMBEDDING_MODEL="openai:text-embedding-3-small"
OPENAI_API_KEY=""

# Optional
# If omitted, SimpleMem uses the local SQLite database at .jido/simplemem.sqlite3.
JIDO_SIMPLEMEM_LOCAL_DB_PATH=""

# Optional
# Set both to use a remote Turso/libSQL database instead of local SQLite.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
